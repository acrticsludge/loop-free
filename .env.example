# Copy/adjust these in:
#   Windows: %USERPROFILE%\.config\opencode\opencode.jsonc
#   Unix:    ~/.config/opencode/opencode.jsonc
#
# Replace each YOUR_* placeholder shown in opencode.jsonc (direct modification).
# Environment substitution is intentionally avoided: OpenCode's background service
# cannot read registry/user env vars reliably.

CONTEXT7_API_KEY=YOUR_CONTEXT7_API_KEY        # context7 MCP
GITHUB_PAT=YOUR_GITHUB_PAT                  # GitHub MCP (github_pat_...)
POSTIZ_BASE_ID=http://localhost:4007/api/mcp
POSTIZ_API_KEY=YOUR_POSTIZ_API_KEY           # required only if running postiz self-hosted
FIGMA_API_KEY=YOUR_FIGMA_API_KEY             # optional, for Framelink_Figma_MCP
VERCEL_TOKEN=                                # optional; usually use OAuth
SENTRY_AUTH=                                  # optional; usually use OAuth
GITHUB_USERNAME=acrticsludge
